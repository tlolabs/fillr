<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:FILLR" x:Class="FILLR.PolicyWindow" x:DataType="vm:PolicyEditor" Title="Media Preferences" Width="540" Height="720" MinWidth="360" MinHeight="400" WindowStartupLocation="CenterOwner">
 <DockPanel Margin="20">
  <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
   <TextBlock Text="{Binding Error}" AutomationProperties.LiveSetting="Assertive" />
   <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right"><Button Content="Cancel" IsCancel="True" Click="Cancel_Click" /><Button Name="SaveButton" Content="Save" IsDefault="True" Click="Save_Click" /></StackPanel>
  </StackPanel>
  <ScrollViewer><StackPanel Spacing="10">
   <TextBlock Text="NTSC 1080i is the default. FILLR waits for a final filename and ten unchanged seconds before deleting rejected media." />
   <CheckBox Content="Filter media" IsChecked="{Binding Enabled}" />
   <CheckBox Content="Delete rejected completed downloads" IsChecked="{Binding DeleteRejected}" />
   <StackPanel><TextBlock Text="Allowed extensions (comma separated; blank = any)" /><TextBox Name="ExtensionsField" Text="{Binding Extensions}" AutomationProperties.Name="Allowed extensions (comma separated; blank = any)" /></StackPanel>
   <StackPanel><TextBlock Text="Allowed containers" /><TextBox Name="ContainersField" Text="{Binding Containers}" AutomationProperties.Name="Allowed containers" /></StackPanel>
   <StackPanel><TextBlock Text="Allowed video codecs" /><TextBox Name="CodecsField" Text="{Binding Codecs}" AutomationProperties.Name="Allowed video codecs" /></StackPanel>
   <StackPanel><TextBlock Text="Required width (blank = any)" /><TextBox Name="WidthField" Text="{Binding Width}" AutomationProperties.Name="Required width (blank = any)" /></StackPanel>
   <StackPanel><TextBlock Text="Required height (blank = any)" /><TextBox Name="HeightField" Text="{Binding Height}" AutomationProperties.Name="Required height (blank = any)" /></StackPanel>
   <StackPanel><TextBlock Text="Frame rate (blank = any)" /><TextBox Name="RateField" Text="{Binding Rate}" AutomationProperties.Name="Frame rate (blank = any)" /></StackPanel>
   <StackPanel><TextBlock Text="Display aspect ratio (blank = any)" /><TextBox Name="AspectField" Text="{Binding Aspect}" AutomationProperties.Name="Display aspect ratio (blank = any)" /></StackPanel>
   <StackPanel><TextBlock Text="TV standard" /><ComboBox ItemsSource="{Binding Standards}" SelectedItem="{Binding Standard}" AutomationProperties.Name="TV standard" HorizontalAlignment="Stretch" /></StackPanel>
   <StackPanel><TextBlock Text="Scan type" /><ComboBox ItemsSource="{Binding Scans}" SelectedItem="{Binding Scan}" AutomationProperties.Name="Scan type" HorizontalAlignment="Stretch" /></StackPanel>
   <StackPanel><TextBlock Text="Orientation" /><ComboBox ItemsSource="{Binding Orientations}" SelectedItem="{Binding Orientation}" AutomationProperties.Name="Orientation" HorizontalAlignment="Stretch" /></StackPanel>
  </StackPanel></ScrollViewer>
 </DockPanel>
</Window>

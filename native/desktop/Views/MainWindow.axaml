<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:FILLR" x:Class="FILLR.MainWindow" x:DataType="vm:MainViewModel" Title="{Binding Title}" Width="800" Height="800" MinWidth="440" MinHeight="400" Icon="/Assets/FILLR.ico">
  <Window.KeyBindings>
    <KeyBinding Gesture="Ctrl+O" Command="{Binding ChooseFolder}" />
    <KeyBinding Gesture="F5" Command="{Binding Refresh}" />
    <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding Preferences}" />
  </Window.KeyBindings>
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="{Binding Title}" Classes="heading" />
      <TextBlock Text="{Binding VersionLabel}" />
      <WrapPanel>
        <Button Name="ChooseFolderButton" Content="Choose CNN Download Folder…" Command="{Binding ChooseFolder}" Margin="0,0,8,8" />
        <Button Name="PreferencesButton" Content="Media Preferences…" Command="{Binding Preferences}" Margin="0,0,8,8" />
        <Button Content="Refresh" Command="{Binding Refresh}" Margin="0,0,8,8" />
        <Button Content="Show / Hide Overlay" Command="{Binding Overlay}" Margin="0,0,8,8" />
      </WrapPanel>
      <TextBlock Text="{Binding Folder}" />
      <Border IsVisible="{Binding Ready}" Padding="12" BorderThickness="1" BorderBrush="{DynamicResource SystemControlForegroundBaseHighBrush}">
        <TextBlock Text="Ready — you can stop downloading. Build the 14 Comp folders." FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite" />
      </Border>
      <TextBlock Text="{Binding Status}" Classes="heading" AutomationProperties.LiveSetting="Polite" />
      <WrapPanel>
        <StackPanel Margin="0,0,32,0"><TextBlock Text="Remaining to 141:10" /><TextBlock Text="{Binding Remaining}" FontSize="42" AutomationProperties.Name="Footage remaining" /></StackPanel>
        <StackPanel><TextBlock Text="Unique footage" /><TextBlock Text="{Binding Available}" FontSize="26" /><TextBlock Text="{Binding Counts}" /></StackPanel>
      </WrapPanel>
      <ProgressBar Minimum="0" Maximum="8470000" Value="{Binding Progress}" AutomationProperties.Name="Footage collected" />
      <ProgressBar IsVisible="{Binding Busy}" IsIndeterminate="True" AutomationProperties.Name="Operation in progress" />
      <WrapPanel>
        <Button Name="BuildButton" Content="Build Comp Folders" Command="{Binding Build}" Classes="accent" Margin="0,0,8,8" />
        <Button Content="Open Last Export" Command="{Binding OpenOutput}" Margin="0,0,8,8" />
      </WrapPanel>
      <TextBlock Text="Comp preview" Classes="heading" />
      <SelectableTextBlock Text="{Binding Preview}" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Notes}" />
      <WrapPanel IsVisible="{Binding UpdatesSupported}">
        <Button Content="Check for Updates…" Command="{Binding CheckUpdates}" Margin="0,0,8,8" />
        <CheckBox Name="AutomaticUpdates" Content="Automatically check for updates" IsChecked="{Binding Automatic, Mode=OneWay}" Command="{Binding ToggleAutomatic}" />
      </WrapPanel>
      <TextBlock Name="ErrorText" Text="{Binding Error}" FontWeight="SemiBold" AutomationProperties.LiveSetting="Assertive" />
    </StackPanel>
  </ScrollViewer>
</Window>

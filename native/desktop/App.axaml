<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="FILLR.App" RequestedThemeVariant="Default">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="FontSize" Value="14" /></Style>
    <Style Selector="Button"><Setter Property="MinHeight" Value="36" /></Style>
    <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
  </Application.Styles>
</Application>

#include <windows.h>
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/../../assets/icons/FILLR.ico"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @FILLR_VERSION_MAJOR@,@FILLR_VERSION_MINOR@,@FILLR_VERSION_PATCH@,0
 PRODUCTVERSION @FILLR_VERSION_MAJOR@,@FILLR_VERSION_MINOR@,@FILLR_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "TLO Labs"
   VALUE "FileDescription", "FILLR"
   VALUE "FileVersion", "@FILLR_VERSION@"
   VALUE "ProductName", "FILLR"
   VALUE "ProductVersion", "@FILLR_VERSION@"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END

<Window
    x:Class="FILLR.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="FILLR">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16" MinWidth="620">
            <TextBlock Text="FILLR" Style="{StaticResource TitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="FolderButton" Content="Choose CNN Download Folder…" Click="ChooseFolder_Click" />
                <Button Content="Media Preferences…" Click="MediaPreferences_Click" />
                <Button x:Name="RefreshButton" Content="Refresh" Click="Refresh_Click" />
                <Button x:Name="OverlayButton" Content="Show Overlay" Click="ToggleOverlay_Click" />
            </StackPanel>
            <TextBlock x:Name="FolderText" Text="Choose the folder where CNN MPG files arrive" TextWrapping="Wrap" Opacity="0.7" />
            <InfoBar x:Name="ReadyBar" Title="Ready — you can stop downloading"
                     Message="Click Build to create the 14 Comp folders." Severity="Success" IsOpen="False" IsClosable="False" />
            <TextBlock x:Name="StatusText" Text="Choose a download folder" Style="{StaticResource SubtitleTextBlockStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="28">
                <StackPanel>
                    <TextBlock Text="Remaining to 141:10" Opacity="0.7" />
                    <TextBlock x:Name="RemainingText" Text="141:10" FontSize="42" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Unique footage" Opacity="0.7" />
                    <TextBlock x:Name="AvailableText" Text="0:00" FontSize="26" />
                    <TextBlock x:Name="ClipCountText" Text="0 usable clips" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
            <ProgressBar x:Name="FootageProgress" Minimum="0" Maximum="8470000" Value="0" />
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="BuildButton" Content="Build Comp Folders" Click="Build_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Name="OpenOutputButton" Content="Open Last Export" Click="OpenOutput_Click" IsEnabled="False" />
            </StackPanel>
            <TextBlock Text="Comp preview" Style="{StaticResource SubtitleTextBlockStyle}" />
            <ListView x:Name="CompList" MaxHeight="300" />
            <TextBlock x:Name="NotesText" TextWrapping="Wrap" Opacity="0.7" />
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="DarkRed" />
        </StackPanel>
    </ScrollViewer>
</Window>
